#!/usr/bin/expect -f
# Password-based deployment for the robot speaker server (now using unitree_sdk2py).
# Opens one interactive SSH session and uses echo markers for reliable completion.
# Usage: expect .deploy_robot_speaker.exp
set timeout 180
set user "unitree"
set host "192.168.52.241"
set pass "123"
set remote_dir "/home/unitree/robot-speaker"
set marker "DEPLOY_MARKER_DONE"

proc run_cmd {label cmd} {
    global marker
    puts "\n\[$label\] $cmd"
    send -- "$cmd && echo $marker\r"
    expect {
        -re "$marker" { }
        timeout {
            puts "\nERROR: timed out during: $label"
            exit 1
        }
    }
}

puts "\nConnecting to ${user}@${host}..."
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${user}@${host}

# Handle password + Unitree distro selection prompt, then wait for the shell prompt.
expect {
    -re "password:\\s*" { send -- "$pass\r"; exp_continue }
    -re "\\)\\s*\\?" { send -- "1\r"; exp_continue }
    -re "unitree@ubuntu" { }
    timeout {
        puts "\nERROR: timed out logging in"
        exit 1
    }
}

# Verify shell readiness with a marker.
send -- "echo $marker\r"
expect {
    -re "$marker" { }
    timeout {
        puts "\nERROR: shell did not become ready"
        exit 1
    }
}

run_cmd "1/4 create dir" "mkdir -p ${remote_dir}"

puts "\n\[2/4\] Copy Python server + optional standalone test tool to robot."
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null robot-speaker-server.py say.py ${user}@${host}:${remote_dir}/
expect {
    -re "password:\\s*" { send -- "$pass\r"; exp_continue }
    -re "noetic" { send -- "1\r"; exp_continue }
    -re "\\) ?" { send -- "1\r"; exp_continue }
    -re "100%" { }
    eof { }
    timeout {
        puts "\nERROR: scp timed out"
        exit 1
    }
}

run_cmd "3/4 verify copy" "ls ${remote_dir}/robot-speaker-server.py"

run_cmd "4/4 restart server" "pkill -f robot-speaker-server.py || true; cd ${remote_dir} && nohup python3 robot-speaker-server.py > /tmp/robot-speaker.log 2>&1 &"

send -- "exit\r"
expect eof

puts "\nDeployment complete."
puts "View logs: ssh ${user}@${host} 'tail -f /tmp/robot-speaker.log'"
puts "Test TTS:  curl -X POST http://${host}:8123/speak-text -H 'Content-Type: application/json' -d '{\"text\":\"你好，机器人\"}'"
